<configuration>

    <!-- Console appender with pattern including level, timestamp, thread, logger and message -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- By default show INFO and above for app-specific packages, DEBUG for our package can be enabled by env -->
    <logger name="com.abernathyclinic.medilabo" level="INFO"/>

    <!-- Reduce spring noise by default -->
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.hibernate" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>

